# Copy to .env.local. For local dev run `supabase start` and use the values it
# prints; the anon key is the only key the app may hold.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── SOURCE SYNC (scripts/differ.mjs) ────────────────────────────────────
# The published CSV/HTML the job READS. Never cited — see *_DOC below.
CID_PARTNER_FLOOR_CSV=
CID_PARTNER_REVIEWS_CSV=
# The canonical document URLs, which ARE what receipts point at. Each must
# already exist as a row in `sources` with the matching data_type.
CID_PARTNER_FLOOR_DOC=
CID_PARTNER_REVIEWS_DOC=
#
# ⚠️ MUST CONNECT AS `postgres` for an APPLY run: is_service_caller() checks
# session_user in ('postgres','supabase_admin'), so a read-only role fails with
# "not authorised" from approve_change. A DRY RUN is fine read-only.
# Supabase dashboard → Connect → session pooler URI.
DATABASE_URL=
