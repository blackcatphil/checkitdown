# Copy to .env.local. For local dev run `supabase start` and use the values it
# prints; the anon key is the only key the app may hold.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── SOURCE SYNC (scripts/differ.mjs) ────────────────────────────────────
# The published CSV/HTML the job READS. Never cited — see *_DOC below.
CID_PARTNER_FLOOR_CSV=
CID_PARTNER_REVIEWS_CSV=
# The canonical document URLs, which ARE what receipts point at. Each must
# already exist as a row in `sources` with the matching data_type.
CID_PARTNER_FLOOR_DOC=
CID_PARTNER_REVIEWS_DOC=
#
# ⚠️ MUST CONNECT AS `postgres` for an APPLY run: is_service_caller() checks
# session_user in ('postgres','supabase_admin'), so a read-only role fails with
# "not authorised" from approve_change. A DRY RUN is fine read-only.
# Supabase dashboard → Connect → session pooler URI.
#
# ⚠️ TWO NAMES, AND THE SPLIT IS NOT COSMETIC. Until 2026-08-12 the production
# string lived under DATABASE_URL — the variable every psql-driving script
# reaches for by default — and migration 017 reached production from a run that
# believed it was local. Now:
#   DATABASE_URL       LOCAL. What a mistake should cost nothing.
#   PROD_DATABASE_URL  PRODUCTION. Asked for by name, never a fallback.
# Anything that writes requires PROD_DATABASE_URL explicitly and prints the host
# it resolved before its first statement — see scripts/db-target.mjs.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PROD_DATABASE_URL=

# Server-side only — NEVER NEXT_PUBLIC_. Writes analytics.events, which is
# not exposed to PostgREST at all. See lib/analytics-server.ts for the standing
# rule this breaks and the alternative costed for review.
SUPABASE_SERVICE_ROLE_KEY=

# The events writer. PROD: the TRANSACTION-mode pooler on 6543, as
# postgresql://cid_events_writer.<project-ref>:<password>@<host>:6543/postgres
# Never 5432 — session mode holds a backend per idle instance. The role holds
# EXECUTE on public.record_events and nothing else; see migration 017.
CID_EVENTS_DATABASE_URL=

# Google Search Console. UNSET = no meta tag at all, which is the current
# behaviour. The tag is preferred over DNS because DNS leaves no repo trace —
# which is why "is this domain verified?" was unanswerable from the code.
GOOGLE_SITE_VERIFICATION=
