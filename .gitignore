# next-env.d.ts — deliberately IGNORED, against Next's own guidance.
#
# Next writes a different import path depending on which command ran last:
#   next build -> import "./.next/types/routes.d.ts"
#   next dev   -> import "./.next/dev/types/routes.d.ts"
# So it CANNOT be stably correct in git. Whichever variant is committed, the
# other mode leaves a permanently dirty tree — and a generated file that is
# always dirty is what trains people to skim diffs.
#
# Next's docs say to commit it. That guidance predates the dev/build path split.
# Do not "fix" this back without re-checking that.
#
# Verified before ignoring (fresh clone, file absent, no .next):
#   - `tsc --noEmit` passes, and genuinely checks (an injected type error fails it)
#   - Next/JSX types resolve without it
#   - `next build` succeeds and REGENERATES the file
next-env.d.ts

# Overpass response caches from scripts/osm-heights.mjs. Regenerable evidence,
# not source: the script is the durable artifact and re-running it re-derives
# these. Kept out of git so a 220KB API dump doesn't read as a reviewed change.
scripts/.rooms/
scripts/.osm-heights-cache.json
scripts/.strip-buildings.json
scripts/.fetch-rooms.sh
# Overpass geometry cache for scripts/room-footprints.mjs. Regenerable; the
# script and the emitted GeoJSON are the artifacts worth keeping.
scripts/.footprints/
spike/.bak.html

# Probe screenshots — build artefacts, reachable in the repo for review.
screens/
.vercel
.env*

# Operational, not structural: who holds admin is not version-controlled.
scripts/bootstrap-admin.sql
